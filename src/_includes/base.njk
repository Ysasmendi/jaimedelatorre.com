<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% if noindex %}<meta name="robots" content="noindex">{% else %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="es_ES">
  <meta name="theme-color" content="#f9f9f7">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label="Jaime de la Torre, inicio">Jaime de la Torre<span aria-hidden="true">.</span></a>
    <nav aria-label="Navegación principal">
      <a href="/#trayectoria">Trayectoria</a>
      <a href="/blog/" {% if section == 'blog' %}aria-current="page"{% endif %}>Blog</a>
      <a href="/#contacto">Contacto <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="contenido">{{ content | safe }}</main>
  <footer class="site-footer wrap">
    <span>© {{ year }} Jaime de la Torre</span>
    <span>Hecho con intención.</span>
    <a href="#contenido">Volver arriba <span aria-hidden="true">↑</span></a>
  </footer>
</body>
</html>
