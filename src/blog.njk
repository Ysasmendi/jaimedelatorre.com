---
layout: base.njk
title: Blog
description: Writing by Jaime de la Torre.
section: blog
permalink: /blog/
---
<section class="text-page wrap">
  <h1>Blog</h1>
  {% if collections.articles.length %}
  <div class="article-list">
    {% for post in collections.articles %}
    <a class="article-row" href="{{ post.url }}"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateLabel }}</time><h2>{{ post.data.title }}</h2><p>{{ post.data.description }}</p></a>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty-note">No posts yet.</p>
  {% endif %}
</section>
