---
layout: base.njk
section: about
---
<div class="about-layout wrap">
  <aside class="portrait">
    <img src="/assets/jaime.jpg" alt="Jaime de la Torre" width="1999" height="2999" fetchpriority="high">
  </aside>
  <section class="experience" aria-label="Experience">
    <h1 class="visually-hidden">Jaime de la Torre</h1>
    <ol class="career-list">
      {% for job in career %}
      <li class="career-item">
        <div class="career-heading"><h2>{{ job.company }}</h2><span class="career-date">{{ job.dates }}</span></div>
        <p>{{ job.description }}</p>
      </li>
      {% endfor %}
    </ol>
  </section>
</div>
