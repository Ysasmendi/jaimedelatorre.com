---
layout: base.njk
section: about
---
<div class="about-layout wrap">
  <aside class="portrait">
    <div class="portrait-image"><img src="/assets/jaime-jtyy.png" alt="Jaime de la Torre de Ysasi-Ysasmendi" width="1024" height="1536" fetchpriority="high"></div>
    <ul class="hobbies" aria-label="Outside work">
      {% for hobby in hobbies %}
      <li>
        <span class="hobby" tabindex="0" role="img" aria-label="{{ hobby.label }}">
          {% include "icons/" + hobby.icon + ".svg" %}
          <span class="hobby-label" aria-hidden="true">{{ hobby.label }}</span>
        </span>
      </li>
      {% endfor %}
    </ul>
  </aside>
  <section class="experience" aria-label="Experience">
    <h1 class="visually-hidden">{{ site.name }}</h1>
    <div class="intro">
      <p class="intro-heading">I scale things from <span>0</span> to <span>∞</span>.</p>
      <p class="intro-detail">Crisis fixer. Process owner. Sparring partner. Tireless negotiator. Devil’s advocate... List continues.</p>
      <div class="intro-actions"><button class="bio-open" type="button" aria-haspopup="dialog" aria-controls="about-bio">More about me ↗</button></div>
    </div>
    <div class="career-scroll">
    <ol class="career-list" aria-label="Career timeline">
      {% for job in career %}
      <li class="career-item" id="career-{{ loop.index }}">
        <a class="timeline-year" href="#career-{{ loop.index }}" aria-label="{{ job.company }}, {{ job.dates }}">
          <span class="timeline-dot" aria-hidden="true"></span>
          <span class="timeline-label"><span class="timeline-start">{{ job.dates.split(' — ')[0] }}</span><span class="timeline-end">— {{ job.dates.split(' — ')[1] }}</span></span>
        </a>
        <div class="career-content">
          <div class="career-heading"><h2>{{ job.company }}</h2></div>
          {% if job.description %}<p>{{ job.description }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
    <div class="reading-track" aria-hidden="true"><span class="reading-fill"></span><span class="reading-dot"></span></div>
    <span class="scroll-hint" aria-hidden="true">More experience ↓</span>
    </div>
  </section>
</div>
<dialog id="about-bio" class="about-dialog" aria-labelledby="bio-title">
  <form method="dialog"><button class="bio-close" aria-label="Close biography" autofocus>×</button></form>
  <h2 id="bio-title">I make things happen.</h2>
  <p>High-agency, detail-oriented, AI superuser, fast-learner professional with emphasis on delivery and execution. Obsessed with customers and quality. Blitzscaler at heart. Strategy nut.</p>
  <p>I take small things and make them big, quickly and efficiently. I also take decisions and make myself accountable for their outcome.</p>
</dialog>
<script src="/assets/timeline.js" defer></script>
<script src="/assets/about.js" defer></script>
