---
layout: base.njk
section: about
---
<div class="about-layout wrap">
  <aside class="portrait">
    <img src="/assets/jaime.jpg" alt="Jaime de la Torre de Ysasi-Ysasmendi" width="1999" height="2999" fetchpriority="high">
    <ul class="hobbies" aria-label="Outside work">
      {% for hobby in hobbies %}
      <li>
        <span class="hobby" tabindex="0" role="img" aria-label="{{ hobby.label }}">
          {% include "icons/" + hobby.icon + ".svg" %}
          <span class="hobby-label" aria-hidden="true">{{ hobby.label }}</span>
        </span>
      </li>
      {% endfor %}
    </ul>
  </aside>
  <section class="experience" aria-label="Experience">
    <h1 class="visually-hidden">{{ site.name }}</h1>
    <div class="intro">
      <p class="intro-heading">I scale things from <span>0</span> to <span>∞</span>.</p>
      <p class="intro-detail">AI enthusiast.</p>
    </div>
    <ol class="career-list">
      {% for job in career %}
      <li class="career-item">
        <div class="career-heading"><h2>{{ job.company }}</h2><span class="career-date">{{ job.dates }}</span></div>
        {% if job.description %}<p>{{ job.description }}</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>
</div>
